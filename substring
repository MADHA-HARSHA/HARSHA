class Solution {
public:
    int longestCommonSubstring(string s1, string s2) {
        int a = s1.size();
        int b = s2.size();

        vector<vector<int>> dp(a + 1, vector<int>(b + 1, 0));
        int result = 0;

        for (int i = 1; i <= a; i++) {
            for (int j = 1; j <= b; j++) {
                if (s1[i - 1] == s2[j - 1]) {
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                    result = max(result, dp[i][j]);
                } else {
                    dp[i][j] = 0;
                }
            }
        }

        return result;
    }
};
